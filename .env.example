# Copia este archivo como `.env` (en esta misma carpeta, arraigados-app/) y
# llena los valores. `.env` NO se comparte ni se sube a ningún lado.

# Conexión a Neon: la MISMA base del proyecto Next.js. Puedes copiar el valor
# de DATABASE_URL del .env del Next.js tal cual (los parámetros que solo usa
# Prisma, como ?schema=public o pgbouncer=true, se ignoran solos).
DATABASE_URL="postgresql://usuario:contraseña@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Clave para firmar las sesiones de Staff/Admin (mínimo 32 caracteres, aleatoria).
# Genérala en PowerShell con:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# Si la cambias, todos los Staff tendrán que volver a iniciar sesión.
SESSION_SECRET="pega-aqui-una-clave-aleatoria-de-al-menos-32-caracteres"

# --- Etapa 3 (Lotes) ---
# Origen con el que se arma el QR de cada pulsera: {PUBLIC_BASE_URL}/p/{qrToken}.
# Desarrollo: déjalo vacío (o bórralo). Con `npm run dev` los enlaces quedan
#   http://localhost:8888/p/{qrToken} automáticamente. NUNCA imprimas pulseras
#   con localhost: no son material oficial.
# Producción: el dominio real definitivo, sin "/" al final (ver docs/PLAN_DOMINIO.md).
#   Si falta en producción, la app NO genera QR (no adivina el dominio).
# Cuidado: el dominio queda GRABADO dentro de cada QR impreso. Cambiarlo después
# invalida las pulseras ya repartidas.
PUBLIC_BASE_URL=""
